# Ansible vault password file — never commit
vault-password.txt
*.vault

# HashiCorp Vault AppRole credentials for the asw-deploy role — these are
# read from VAULT_ROLE_ID/VAULT_SECRET_ID env vars (group_vars/all.yml), but
# guard against a local convenience file (.envrc, a sourced .env) leaking in
vault-approle*
.envrc

# Retry files left by failed runs
*.retry

# Local IP-override inventory (worked around a WSL control node that
# couldn't resolve Tailscale MagicDNS hostnames) — machine-specific, not the
# intended inventory mechanism, never commit
.scratch-inventory-ip-override.yml

# Same reasoning, but for the Stage 1 Terraform test VMs (201/204/205/206) -
# their Tailscale names differ from the inventory hostnames the playbooks
# target (e.g. "linux-mysql-1" due to a hostname collision with production),
# so ansible_host needs pointing at the test VMs' actual Tailscale IPs
.scratch-inventory-stage1-test.yml

# Same reasoning again, extended to cover the full test loop (4 VMs + the
# 2 test CTs added later) for the terraform-to-ansible automation script
.scratch-inventory-test-loop.yml
