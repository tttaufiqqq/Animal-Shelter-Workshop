# Managed by Ansible (playbooks/linux-observability.yml) — do not edit by hand.
global:
  resolve_timeout: 5m

route:
  receiver: telegram
  group_by: ["alertname", "instance"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 3h

receivers:
  - name: telegram
    telegram_configs:
      - bot_token: "{{ asw_secrets.telegram_bot_token }}"
        chat_id: {{ asw_secrets.telegram_chat_id }}
        api_url: "https://api.telegram.org"
        parse_mode: "HTML"
        message: |-
{% raw %}
          {{- range .Alerts }}
          {{ if eq .Status "firing" }}🔥 <b>FIRING</b>{{ else }}✅ <b>RESOLVED</b>{{ end }} — {{ .Labels.alertname }}
          {{- if eq .Labels.severity "critical" }}
          🚨 Severity: critical
          {{- else if eq .Labels.severity "warning" }}
          ⚠️ Severity: warning
          {{- else }}
          🔔 Severity: {{ .Labels.severity }}
          {{- end }}

          • Instance: {{ .Labels.instance }}
          {{- if eq .Status "firing" }}
          • Since: {{ .StartsAt.Format "15:04:05" }}
          {{- else }}
          • Duration: {{ .EndsAt.Sub .StartsAt }}
          {{- end }}
          • Summary: {{ .Annotations.summary }}

          ———————————
          {{- end }}
{% endraw %}
