---
# Managed by Ansible (playbooks/linux-observability.yml) — do not edit by hand.
global:
  scrape_interval: 15s
  evaluation_interval: 15s

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["localhost:9093"]

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: node
    static_configs:
{% for host in groups['monitoring_targets'] %}
      - targets: ["{{ hostvars[host]['ansible_host'] }}:9100"]
        labels:
          instance: "{{ host }}"
{% endfor %}
